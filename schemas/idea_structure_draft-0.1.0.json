{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appcompass.local/schemas/idea_structure_draft-0.1.0.json",
  "title": "IdeaStructureDraft",
  "description": "LLM이 만든 구조화 초안. 점수·신뢰도·피벗 판정은 절대 포함하지 않는다 (ADR-0002). 값이 원문에 없으면 빈 문자열로 둔다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields", "unknowns", "notes"],
  "properties": {
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_user",
        "payer",
        "influencer",
        "problem_situation",
        "current_solution",
        "current_solution_problem",
        "core_action",
        "expected_result",
        "first_success",
        "retention_reason",
        "revenue_model",
        "distribution_channel"
      ],
      "properties": {
        "target_user": { "type": "string" },
        "payer": { "type": "string" },
        "influencer": { "type": "string" },
        "problem_situation": { "type": "string" },
        "current_solution": { "type": "string" },
        "current_solution_problem": { "type": "string" },
        "core_action": { "type": "string" },
        "expected_result": { "type": "string" },
        "first_success": { "type": "string" },
        "retention_reason": { "type": "string" },
        "revenue_model": { "type": "string" },
        "distribution_channel": { "type": "string" }
      }
    },
    "unknowns": {
      "description": "원문만으로는 알 수 없어 사람이 확인해야 하는 것 (CLAUDE.md §2.4).",
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "description": "칸마다 그 값이 어디서 왔는지. 추측을 사실처럼 보이게 하지 않기 위한 장치다.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "basis", "reason"],
        "properties": {
          "field": {
            "enum": [
              "target_user",
              "payer",
              "influencer",
              "problem_situation",
              "current_solution",
              "current_solution_problem",
              "core_action",
              "expected_result",
              "first_success",
              "retention_reason",
              "revenue_model",
              "distribution_channel"
            ]
          },
          "basis": {
            "description": "FROM_RAW_TEXT=원문에 그대로 있음 / INFERRED=원문에서 추측함 / MISSING=원문에 없어 비워 둠",
            "enum": ["FROM_RAW_TEXT", "INFERRED", "MISSING"]
          },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
