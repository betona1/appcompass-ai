{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appcompass.local/schemas/analysis_result-0.1.0.json",
  "title": "AnalysisResult",
  "description": "AppCompass 분석 결과 출력 계약. 이 스키마를 통과하지 못한 결과로는 점수나 피벗 결정을 저장하지 않는다.",
  "type": "object",
  "required": ["meta", "idea", "diagnosis", "targets", "mvp", "pivot", "next_actions"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "engine",
        "engine_version",
        "policy_version",
        "schema_version",
        "domain_code"
      ],
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "engine_version": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "domain_code": { "enum": ["GENERIC", "VIBEQUEST", "EXAMATH"] },
        "model_provider": { "type": ["string", "null"] },
        "model_name": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "created_at": { "type": ["string", "null"] }
      }
    },
    "idea": {
      "type": "object",
      "required": [
        "app_name",
        "target_user",
        "problem_situation",
        "core_action",
        "expected_result"
      ],
      "properties": {
        "app_name": { "type": "string" },
        "target_user": { "type": "string" },
        "payer": { "type": ["string", "null"] },
        "influencer": { "type": ["string", "null"] },
        "problem_situation": { "type": "string" },
        "current_solution": { "type": ["string", "null"] },
        "current_solution_problem": { "type": ["string", "null"] },
        "core_action": { "type": "string" },
        "expected_result": { "type": "string" },
        "first_success": { "type": ["string", "null"] },
        "retention_reason": { "type": ["string", "null"] },
        "revenue_model": { "type": ["string", "null"] },
        "distribution_channel": { "type": ["string", "null"] },
        "unknowns": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": [
        "total_score",
        "overall_confidence",
        "dimensions",
        "warnings",
        "critical_risks",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "overall_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dimensions": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "code",
              "label",
              "raw_score",
              "weight",
              "normalized_score",
              "reason",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": ["D01","D02","D03","D04","D05","D06","D07","D08","D09","D10"]
              },
              "label": { "type": "string" },
              "raw_score": { "type": "integer", "minimum": 0, "maximum": 5 },
              "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
              "normalized_score": { "type": "number", "minimum": 0, "maximum": 100 },
              "reason": { "type": "string", "minLength": 1 },
              "missing_evidence": { "type": "array", "items": { "type": "string" } },
              "recommended_action": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message", "severity"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "severity": { "enum": ["INFO", "WARN", "CRITICAL"] },
              "field": { "type": ["string", "null"] },
              "recommended_action": { "type": "string" }
            }
          }
        },
        "critical_risks": { "type": "array", "items": { "type": "string" } },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "targets": {
      "type": "object",
      "required": ["candidates", "recommended_candidate_index", "recommendation_reason"],
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "user"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "user": { "type": "string", "minLength": 1 },
              "payer": { "type": ["string", "null"] },
              "influencer": { "type": ["string", "null"] },
              "trigger_situation": { "type": "string" },
              "problem": { "type": "string" },
              "current_alternative": { "type": ["string", "null"] },
              "why_promising": { "type": "array", "items": { "type": "string" } },
              "risks": { "type": "array", "items": { "type": "string" } },
              "validation_questions": { "type": "array", "items": { "type": "string" } },
              "recommended_experiment": { "type": "string" }
            }
          }
        },
        "recommended_candidate_index": { "type": ["integer", "null"], "minimum": 0 },
        "recommendation_reason": { "type": "string" },
        "source": { "enum": ["RULE", "LLM", "HUMAN"] }
      }
    },
    "mvp": {
      "type": "object",
      "required": ["core_hypothesis", "p0_features", "excluded_features", "metrics"],
      "additionalProperties": false,
      "properties": {
        "core_hypothesis": { "type": "string" },
        "problem_hypothesis": { "type": "string" },
        "behavior_hypothesis": { "type": "string" },
        "value_hypothesis": { "type": "string" },
        "retention_hypothesis": { "type": "string" },
        "revenue_hypothesis": { "type": ["string", "null"] },
        "p0_features": { "type": "array", "items": { "type": "string" } },
        "p1_features": { "type": "array", "items": { "type": "string" } },
        "excluded_features": { "type": "array", "items": { "type": "string" } },
        "first_success_experience": { "type": "string" },
        "core_user_flow": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "source": { "enum": ["RULE", "LLM", "HUMAN"] }
      }
    },
    "pivot": {
      "type": "object",
      "required": ["decision", "confidence", "reason_codes", "rationale", "requires_human_approval"],
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "KEEP","REFINE","TARGET_PIVOT","PROBLEM_PIVOT","SOLUTION_PIVOT",
            "CHANNEL_PIVOT","REVENUE_PIVOT","RETENTION_REDESIGN","HOLD"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 },
        "would_be_decision": {
          "type": ["string", "null"],
          "enum": [
            "KEEP","REFINE","TARGET_PIVOT","PROBLEM_PIVOT","SOLUTION_PIVOT",
            "CHANNEL_PIVOT","REVENUE_PIVOT","RETENTION_REDESIGN","HOLD", null
          ]
        },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "keep": { "type": "array", "items": { "type": "string" } },
        "change": { "type": "array", "items": { "type": "string" } },
        "remove": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } },
        "requires_human_approval": { "type": "boolean" }
      }
    },
    "next_actions": { "type": "array", "items": { "type": "string" } }
  }
}
